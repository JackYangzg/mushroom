# ============================================================================
# Mushroom App — 环境变量 / Secret 注入示例
# ============================================================================
#
# 本文件**不**会被项目加载，仅作为新成员上手参考。
# 真实配置请复制为 local.properties 并填入实际值（local.properties 已被
# .gitignore 排除，绝不会进入版本控制）。
#
# 为什么要这套机制？
# 1. 严禁把任何 API key 写进 .kt / .java / .gradle 源码
# 2. 严禁把 key 提交到 git（即使后续删除，git history 仍会留痕）
# 3. 客户端不直接持有 key 的最佳实践是：服务端代理（BFF），见设计文档 §8.1
# 4. 本期 MVP 退而求其次：通过 gitignored local.properties 注入到 BuildConfig
# 5. 识别页面可在豆包与 MiniMax 之间切换，默认选择豆包
#
# ============================================================================

# 当前默认：火山方舟豆包
# 控制台: https://console.volcengine.com/ark
# 注入位置: local.properties → BuildConfig.ARK_API_KEY → DoubaoApiClient

ARK_API_KEY=ark-your-api-key

# 保留的 MiniMax 配置，供识别页面切换使用。
#
# MiniMax M3（MiniMax 平台）大模型识别 API
# 控制台: https://platform.minimaxi.com
# API 文档: https://platform.minimaxi.com/docs/api-reference/text-chat-openai
# 签发: 登录控制台 → API Keys → Create new key → 复制 sk-cp-... 前缀的串
# 注入位置: local.properties（gitignored）→ app/build.gradle 读取 →
#           BuildConfig.MINIMAX_API_KEY → MiniMaxApiClient

MINI_MAX_API_KEY=sk-cp-***REDACTED***

# MiniMax API 基础地址（一般无需修改）
MINIMAX_API_BASE=https://api.minimaxi.com

# 模型名（一般无需修改）
MINIMAX_MODEL=MiniMax-M3

# ============================================================================
# iflora 学术数据库（公开 API，无 key）
# ============================================================================
# 详情页:  https://fungi.iflora.cn/#/speciesDetail/{ID}/{URL_ENCODED_NAME}/list
# 3D 平台: https://mushroom.iflora.cn/?search={URL_ENCODED_NAME}
# ============================================================================

# ============================================================================
# 轮换 / 应急
# ============================================================================
# 若 key 意外泄露（如误提交到 git、聊天日志、截图）：
#   1. 立即在 MiniMax 控制台 Revoke + 重新签发
#   2. 更新 local.properties 中的 MINI_MAX_API_KEY
#   3. 检查 git log: git log -p -- local.properties   （应无记录）
#   4. 若已入仓: 用 BFG Repo-Cleaner 或 git filter-repo 清理历史
#   5. 评估：旧 key 产生的费用，申请 MiniMax 风控退款
# ============================================================================
